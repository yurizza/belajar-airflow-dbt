    create  table
      "warehouse"."main"."fact_payment_transaction__dbt_tmp"
  
    as (
      select
    pt.payment_id,
    pt.customer_key,
    pt.transaction_date,
    pt.transaction_time,
    pt.payment_method_id,
    pt.currency_code,
