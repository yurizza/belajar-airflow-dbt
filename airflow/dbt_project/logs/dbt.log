  create view "warehouse"."main"."stg_reservation__dbt_tmp" as (
    with source as (
    select 
        reservation_id,
        customer_key,
        guest_id,
        hotel_id,
        segment_id,
        booking_date,
        destination_city,
        checkin_date,   -- Menggunakan kolom asli dari DDL PostgreSQL
        checkout_date,  -- Menggunakan kolom asli dari DDL PostgreSQL
