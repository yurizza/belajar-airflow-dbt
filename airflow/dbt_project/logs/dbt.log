  create view "warehouse"."main"."int_flight__dbt_tmp" as (
    select
    b.booking_id,
    b.customer_key,
    fs.segment_id,
    fs.origin_airport_code,
    fs.destination_airport_code,
    fs.scheduled_departure,
    fs.actual_departure,
    fs.gross_amount_usd,
    ac.aircraft_id,
    ac.registration_number,
    ac.seat_capacity,
    bc.channel_key
from "warehouse"."main"."stg_booking" b
join "warehouse"."main"."stg_flight_segment" fs on b.booking_id = fs.booking_id
join "warehouse"."main"."stg_airport" ap on fs.origin_airport_code = ap.airport_code
join "warehouse"."main"."stg_booking_channel" bc on b.channel_key = bc.channel_key
  );

