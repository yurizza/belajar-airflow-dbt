  create view "warehouse"."main"."stg_customer__dbt_tmp" as (
    select
    cast(customer_key as integer) as customer_key,
    customer_id,
    concat(upper(substring(first_name, 1, 1)), lower(substring(first_name, 2))) as first_name,
